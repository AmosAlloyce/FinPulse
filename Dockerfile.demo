FROM node:26-alpine AS frontend
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM python:3.12-slim AS demo
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src FINPULSE_DATA_DIR=/app/data FINPULSE_WEB_DIST=/app/web/dist \
    COOKIE_PATH=/finpulse
WORKDIR /app
COPY requirements.demo.txt ./
RUN pip install --no-cache-dir -r requirements.demo.txt \
    && useradd --create-home --uid 10001 finpulse \
    && mkdir -p /app/data && chown finpulse:finpulse /app/data
COPY --chown=finpulse:finpulse src ./src
COPY --chown=finpulse:finpulse --from=frontend /web/dist ./web/dist
USER finpulse
EXPOSE 8011
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8011/api/health',timeout=4).read()"
CMD ["uvicorn", "finpulse.demo.main:app", "--host", "0.0.0.0", "--port", "8011", "--proxy-headers", "--forwarded-allow-ips", "*"]
