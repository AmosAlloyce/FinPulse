# Runtime
FINPULSE_ENV=development
FINPULSE_LOG_LEVEL=INFO
FINPULSE_RANDOM_SEED=42
FINPULSE_COUNTRIES=KEN,UGA,GHA,TZA,ZMB

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_RAW_TOPIC=finpulse.events.raw.v1
KAFKA_DLQ_TOPIC=finpulse.events.dlq.v1
KAFKA_CHECKPOINT_TOPIC=finpulse.checkpoints.v1

# Object storage (S3-compatible MinIO locally)
AWS_ACCESS_KEY_ID=finpulse
AWS_SECRET_ACCESS_KEY=finpulse-secret
AWS_REGION=af-south-1
S3_ENDPOINT=http://minio:9000
S3_BUCKET=finpulse-lakehouse

# Warehouse
POSTGRES_USER=finpulse
POSTGRES_PASSWORD=finpulse
POSTGRES_DB=finpulse
WAREHOUSE_DSN=postgresql://finpulse:finpulse@postgres:5432/finpulse

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=finpulse-local-secret

# Dashboard/API
API_URL=http://api:8000
DEMO_EVENT_RATE=20

